<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:scaleType="centerCrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:id="@+id/deckpicker_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/pull_to_sync_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/deck_picker_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/onigiri_deck_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="22dp"
                        android:paddingBottom="12dp">

                        <com.ichi2.ui.FixedTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/onigiri_header_eyebrow"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12" />

                        <com.ichi2.ui.FixedTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/onigiri_header_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />

                        <com.ichi2.ui.FixedTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/onigiri_header_subtitle"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/onigiri_today_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:background="@drawable/onigiri_today_card_background">

                            <com.ichi2.ui.FixedTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/onigiri_today_eyebrow"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.12" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.8"
                                    android:orientation="vertical">

                                    <com.ichi2.ui.FixedTextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/onigiri_due_label"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="12sp" />

                                    <com.ichi2.ui.FixedTextView
                                        android:id="@+id/onigiri_due_count"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="—"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="32sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="44dp"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginEnd="14dp"
                                    android:background="?attr/colorOutlineVariant" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:orientation="vertical">

                                    <com.ichi2.ui.FixedTextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/onigiri_studied_label"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="12sp" />

                                    <com.ichi2.ui.FixedTextView
                                        android:id="@+id/onigiri_studied_today"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/onigiri_studied_placeholder"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="13sp"
                                        android:maxLines="3"
                                        android:ellipsize="end" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <com.ichi2.anki.ui.BottomFadeFrameLayout
                            android:id="@+id/decks_fade_wrapper"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/decks"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clipToPadding="false"
                                android:drawSelectorOnTop="true"
                                android:fastScrollEnabled="true"
                                android:focusable="true"
                                android:paddingBottom="72dp"
                                android:scrollbars="vertical" />
                        </com.ichi2.anki.ui.BottomFadeFrameLayout>

                        <com.ichi2.ui.FixedTextView
                            android:id="@+id/review_summary_text_view"
                            android:layout_width="match_parent"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="4dp"
                            android:gravity="center" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/no_decks_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:layout_gravity="center_horizontal"
                        app:srcCompat="@drawable/anki_box" />

                    <com.ichi2.ui.FixedTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:text="@string/no_cards_placeholder_title"
                        style="@style/TextAppearance.AppCompat.Medium" />

                    <com.ichi2.ui.FixedTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/no_cards_placeholder_description"
                        style="@style/TextAppearance.AppCompat.Body1" />
                </LinearLayout>

            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <include layout="@layout/include_anki_progress"/>
    <include
        android:id="@+id/floating_action_button"
        layout="@layout/include_floating_add_button"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
